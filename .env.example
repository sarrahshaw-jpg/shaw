# CEO AI Executive Assistant — environment template
# Copy to .env and fill in. NEVER commit .env.
# Every integration below is optional until its phase is approved.

# ---- core ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=https://ea.example.com          # public HTTPS URL for webhooks
TZ_DEFAULT=Asia/Dubai                         # never hard-code in source
OPERATING_HOURS_START=10:00
OPERATING_HOURS_END=22:00
BRIEFING_TIME=10:00

# ---- state ---------------------------------------------------------------
DATABASE_URL=postgres://ea:ea@localhost:5432/ea
REDIS_URL=redis://localhost:6379
VAULT_MASTER_KEY=                             # 32-byte base64, encrypts stored tokens

# ---- reasoning -----------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_REASONING=claude-opus-5
MODEL_CLASSIFY=claude-sonnet-5

# ---- Hostinger Mail (Phase 7) --------------------------------------------
HOSTINGER_API_TOKEN=
HOSTINGER_MAILBOX_ID=                         # AC... resource id
HOSTINGER_WEBHOOK_SECRET=

# ---- Google (Phase 6) ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                         # offline access
GOOGLE_CALENDAR_ID=primary

# ---- Zoom (Phase 8, blocked on decision #4) ------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ---- Zoho CRM (Phase 9, blocked on decision #5) --------------------------
ZOHO_REGION=com                               # com | eu | in | sa | au | jp
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---- notifications (Phase 15, decision #7) -------------------------------
NOTIFY_CHANNEL=                               # whatsapp | email | push | claude
